# Database
MONGODB_URI=mongodb://localhost:27017/wordwars

# JWT Secret
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production

# Server Port
PORT=3000

# Client URL (used to build the links in the verification and password-reset emails)
CLIENT_URL=http://localhost:4200

# Email (Resend, https://resend.com). Without RESEND_API_KEY nothing is sent: the email
# (and its link) is printed to the server console. In production, email verification is
# only required once this key is set.
# EMAIL_FROM must belong to a domain verified in Resend; onboarding@resend.dev only
# delivers to the address of your own Resend account.
RESEND_API_KEY=
EMAIL_FROM=WordWars <onboarding@resend.dev>
