{
  "name": "wordwars",
  "version": "1.0.0",
  "description": "WordWars - Juego de palabras online con ranking ELO",
  "main": "dist/server.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/server.js",
    "dev": "ts-node-dev --respawn --transpile-only src/server.ts",
    "dev:client": "npm --prefix client-angular start",
    "build:client": "npm --prefix client-angular run build",
    "build:all": "npm run build && npm run build:client",
    "test:client": "npm --prefix client-angular test",
    "compress:images": "node scripts/compress-images.mjs"
  },
  "dependencies": {
    "axios": "^1.5.0",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "disposable-email-domains": "^1.0.62",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "express-rate-limit": "^8.7.0",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.2",
    "mongodb": "^7.6.0",
    "mongoose": "^7.5.0",
    "socket.io": "^4.7.2"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.2",
    "@types/body-parser": "^1.19.6",
    "@types/cors": "^2.8.13",
    "@types/express": "^4.17.17",
    "@types/jsonwebtoken": "^9.0.2",
    "@types/node": "^20.5.0",
    "nodemon": "^3.0.1",
    "sharp": "^0.33.5",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.1.6"
  },
  "keywords": [
    "game",
    "words",
    "spanish",
    "online",
    "elo",
    "typescript"
  ],
  "author": "Ruben",
  "license": "MIT"
}
